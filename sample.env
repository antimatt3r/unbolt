# Port to expose on the host machine
HOST_PORT=8000

# Path to the local directory containing primary_passwords.txt and user_passwords.txt
HOST_DATA_PATH=./data/

# URL of the UNBOLT API for the CLI client (unbolt.py)
UNBOLT_URL=http://localhost:8000

# --- Security & Hardening Settings ---

# Maximum allowed file size in bytes (default is 104857600 bytes = 100MB)
# UNBOLT_MAX_FILE_SIZE=104857600

# Rate limiting request count threshold (default is 60 requests)
# UNBOLT_RATE_LIMIT_REQUESTS=60

# Rate limiting sliding window in seconds (default is 60 seconds)
# UNBOLT_RATE_LIMIT_WINDOW=60
